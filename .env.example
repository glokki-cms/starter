# ── Required ──────────────────────────────────────────────
# Your glokki CMS address
CMS_BASE_URL=https://app.glokki.com
# Your organization's slug (Settings → General)
CMS_TENANT=
# An API key with ONLY the delivery:read scope (Settings → API keys).
# It is embedded in your site's browser JavaScript: never use an
# admin-scoped key here.
CMS_API_KEY=
# Shared secret for /api/revalidate. Paste the same value into
# Settings → Visual Editor → Webhook Secret. Generate: openssl rand -hex 32
CMS_REVALIDATE_SECRET=

# ── Optional ──────────────────────────────────────────────
# paper | grid | dusk (default: grid)
NEXT_PUBLIC_THEME=grid
# Comma-separated locales; set them to your organization's locales.
# The default one has no URL prefix.
CMS_LOCALES=en,pl
CMS_DEFAULT_LOCALE=en
# Public origin. On Vercel it defaults to the production domain.
# Read at build time: rebuild after changing it.
# NEXT_PUBLIC_SITE_URL=https://www.example.com
# Only "production" is indexed by search engines. On Vercel it is derived from
# VERCEL_ENV automatically; on any other host set it when building your
# live site (it is read at build time, not at runtime).
# APP_ENV=production
